{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.development)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/.env.secret)",
      "Edit(**/.env.secrets)",
      "Bash(grep *.env.local*)",
      "Bash(rg *.env.local*)",
      "Bash(awk *.env.local*)",
      "Bash(less *.env.local*)",
      "Bash(more *.env.local*)",
      "Bash(xxd *.env.local*)",
      "Bash(strings *.env.local*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)"
    ]
  }
}
